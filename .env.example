# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=html5_examples

# JWT Configuration
JWT_SECRET=<生成随机32位密钥: openssl rand -hex 32>
JWT_EXPIRES_IN=7d

# Admin
ADMIN_DEFAULT_PASSWORD=<设置强密码>

# Application
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5555

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=root
DB_PASSWORD=root1234
DB_NAME=html5_examples
DB_SYNC=true

JWT_SECRET=<请替换为强随机串>
JWT_EXPIRES_IN=7d

ADMIN_DEFAULT_PASSWORD=admin123

PORT=3000
NODE_ENV=development
TZ=Asia/Shanghai

# ── 限流存储 ───────────────────────────────────────────────
# auto（默认）：配置了 REDIS_URL 就用 Redis，否则用进程内计数
# memory：强制进程内；redis：强制 Redis（连不上会降级并告警）
RATE_LIMIT_STORE=auto
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_PREFIX=ratelimit:

# ── 反向代理 ───────────────────────────────────────────────
# 默认关闭。部署在 nginx / 网关之后时设为 loopback（或信任的跳数），
# 否则限流取到的是代理 IP，所有用户共用同一个计数窗口。
# 未经过代理时**不要**开启：客户端可伪造 X-Forwarded-For 绕过限流。
TRUST_PROXY=loopback
